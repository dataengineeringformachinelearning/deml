{
  "name": "deml",
  "version": "0.0.0",
  "private": true,
  "description": "DEML control plane — Angular app on deml-ui, Django BFF, contracts",
  "packageManager": "npm@11.18.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ng": "ng",
    "prestart": "node set-env.js",
    "start": "ng serve",
    "prebuild": "node set-env.js && npm run build --workspace @dataengineeringformachinelearning/deml-contracts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "node set-env.js && ng build --configuration development",
    "serve:ssr:deml": "node dist/deml/server/server.mjs",
    "build:contracts": "npm run build --workspace @dataengineeringformachinelearning/deml-contracts",
    "validate:config": "python3 scripts/check_config_catalog.py",
    "validate:contracts": "npm run build:contracts && uv run --project packages/deml-contracts python -c \"from deml_contracts import USE_CASE_IDS, SealedEvent; assert len(USE_CASE_IDS)==37\"",
    "validate:usecase-coverage": "python3 scripts/check_usecase_coverage.py",
    "check:nfts": "node scripts/check_nfts_style.mjs",
    "validate:nfts": "npm run check:nfts"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "@dataengineeringformachinelearning/deml-contracts": "file:packages/deml-contracts",
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/angular": "^1.28.0",
    "@sanity/client": "^7.26.0",
    "@sentry/angular": "^10.69.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "deml-ui": "github:dataengineeringformachinelearning/deml-ui#ef102ce733406e5c92cb09727dda045456890fff",
    "express": "^5.1.0",
    "firebase": "^12.17.0",
    "leaflet": "^1.9.4",
    "rollbar": "^3.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "deml-ui": true
  }
}
