{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "lib/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@dataengineeringformachinelearning/deml-contracts#build": {
      "outputs": ["dist/**"]
    },
    "@dataengineeringformachinelearning/viking-ui#build": {
      "dependsOn": ["@dataengineeringformachinelearning/deml-contracts#build"],
      "outputs": ["dist/**"]
    }
  }
}
