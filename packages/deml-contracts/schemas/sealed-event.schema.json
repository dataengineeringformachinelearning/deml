{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deml.app/schemas/sealed-event.json",
  "title": "SealedEvent",
  "description": "UC-INGEST-001/002 DEML wire shape before deml_* → threat_* rewrite.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "client_event_id",
    "content_type",
    "event_type",
    "schema_version",
    "workflow_id",
    "encryption",
    "envelope"
  ],
  "properties": {
    "tenant_id": { "type": "string", "format": "uuid" },
    "client_event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "content_type": {
      "type": "string",
      "const": "application/forjd-telemetry+v1"
    },
    "event_type": {
      "type": "string",
      "enum": ["deml.metric", "deml.alert"]
    },
    "schema_version": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "workflow_id": { "type": "string", "const": "deml_telemetry" },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "algo"],
      "properties": {
        "mode": { "const": "e2ee" },
        "algo": { "const": "aes-256-gcm" }
      }
    },
    "envelope": { "$ref": "#/$defs/EncryptedEnvelope" },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "enum": [
          "source",
          "channel",
          "region",
          "env",
          "environment",
          "product",
          "component",
          "namespace",
          "device_id",
          "series_id",
          "label",
          "labels",
          "tags"
        ]
      },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 128 },
          {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        ]
      }
    }
  },
  "$defs": {
    "EncryptedEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algo", "key_id", "nonce", "ciphertext", "ciphertext_sha256"],
      "properties": {
        "algo": { "const": "aes-256-gcm" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "nonce": { "type": "string", "minLength": 8, "maxLength": 64 },
        "ciphertext": { "type": "string", "minLength": 24, "maxLength": 1048576 },
        "ciphertext_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ratchet_header": {
          "type": ["string", "null"],
          "maxLength": 8192
        }
      }
    }
  }
}
