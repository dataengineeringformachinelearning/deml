{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deml.app/schemas/billing.json",
  "title": "BillingContracts",
  "description": "UC-BILL-001..003 Stripe checkout/sync/cancel DTOs.",
  "$defs": {
    "CheckoutSessionOut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkout_url"],
      "properties": {
        "checkout_url": { "type": "string", "minLength": 1 }
      }
    },
    "BillingSyncOut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "active"],
      "properties": {
        "status": { "type": "string", "const": "synced" },
        "active": { "type": "boolean" },
        "cancel_at_period_end": { "type": "boolean", "default": false },
        "message": { "type": ["string", "null"] }
      }
    },
    "SubscriptionMutateOut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cancel_at_period_end"],
      "properties": {
        "status": { "type": "string", "enum": ["cancelled", "resumed"] },
        "cancel_at_period_end": { "type": "boolean" }
      }
    },
    "BillingErrorOut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": { "type": "string", "minLength": 1 }
      }
    }
  }
}
