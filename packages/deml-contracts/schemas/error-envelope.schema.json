{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deml.app/schemas/error-envelope.json",
  "title": "ErrorEnvelope",
  "description": "Shared DEML BFF JSON error body (UC cross-cutting).",
  "type": "object",
  "additionalProperties": false,
  "required": ["detail"],
  "properties": {
    "detail": { "type": "string", "minLength": 1 },
    "code": {
      "type": "string",
      "enum": [
        "forjd_degraded",
        "forjd_forbidden",
        "pro_required",
        "validation_error",
        "rate_limited",
        "not_authenticated",
        "not_found",
        "checkout_disabled",
        "lifecycle_blocked"
      ]
    }
  }
}
