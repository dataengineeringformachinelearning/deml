{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deml.app/schemas/ready.json",
  "title": "ReadyResponse",
  "description": "UC-HEALTH-001 DEML readiness (soft FORJD dependency).",
  "type": "object",
  "additionalProperties": true,
  "required": ["status"],
  "properties": {
    "status": { "type": "string", "enum": ["ok", "ready", "degraded"] },
    "forjd_health": {
      "type": "string",
      "enum": ["ok", "degraded", "unknown", "unconfigured"]
    },
    "mode": { "type": "string", "enum": ["full", "degraded"] },
    "forjd_read_mode": { "type": "string", "enum": ["off", "forjd", "dual"] },
    "forjd_write_mode": { "type": "string", "enum": ["off", "forjd", "dual"] }
  }
}
