{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deml.app/schemas/consent.json",
  "title": "ConsentContracts",
  "description": "UC-CONSENT-001/002 cookie consent and newsletter DTOs.",
  "$defs": {
    "ConsentIn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "necessary": { "type": "boolean", "default": true },
        "analytical": { "type": "boolean", "default": false },
        "marketing": { "type": "boolean", "default": false }
      }
    },
    "ConsentRecordOut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "id"],
      "properties": {
        "status": { "type": "string", "enum": ["success", "recorded"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "NewsletterIn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "consent_accepted"],
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 254 },
        "consent_accepted": { "type": "boolean" }
      }
    },
    "NewsletterSubscribeOut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "id"],
      "properties": {
        "status": { "type": "string", "enum": ["success", "subscribed"] },
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
