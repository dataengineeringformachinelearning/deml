{
  "name": "@dataengineeringformachinelearning/deml-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical DEML use-case TypeScript + schema contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./openapi/*": "./openapi/*"
  },
  "files": [
    "dist",
    "typescript/src",
    "schemas",
    "openapi",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p typescript/tsconfig.json --noEmit",
    "build": "tsc -p typescript/tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  }
}
