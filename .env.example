# DEML monorepo — shared suite URLs (config/deml.catalog.json)
#
# Layer-specific secrets and keys live in:
#   backend/.env.example     — Django BFF / Fly
#   .env.frontend.example    — Angular / Vercel (build-time via set-env.js)
#
# Copy the layer file you need:
#   cp backend/.env.example backend/.env
#   cp .env.frontend.example .env
#
# Validate inventory:
#   npm run validate:config

FRONTEND_URL=https://deml.app
BACKEND_URL=https://backend.deml.app
MARKETING_URL=https://dataengineeringformachinelearning.com
FORJD_API_URL=https://backend.forjd.co

# Local overrides (optional)
# FRONTEND_URL=http://localhost:4200
# BACKEND_URL=http://localhost:8000
# MARKETING_URL=http://localhost:4321
