{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node set-env.js && npm run build:contracts && NG_BUILD_MAX_WORKERS=1 GOMAXPROCS=1 NODE_OPTIONS=--max-old-space-size=1536 npx ng build --configuration vercel && cp dist/deml/browser/index.csr.html dist/deml/browser/index.html",
  "outputDirectory": "dist/deml/browser",
  "framework": null,
  "installCommand": "rm -rf node_modules/deml-ui && npm install --include=dev --prefer-online --no-audit --no-fund",
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://dataengineeringformachinelearning.com/documentation",
      "permanent": true
    },
    {
      "source": "/docs/",
      "destination": "https://dataengineeringformachinelearning.com/documentation",
      "permanent": true
    },
    {
      "source": "/redoc",
      "destination": "https://dataengineeringformachinelearning.com/documentation",
      "permanent": true
    },
    {
      "source": "/redoc/",
      "destination": "https://dataengineeringformachinelearning.com/documentation",
      "permanent": true
    },
    {
      "source": "/swagger",
      "destination": "https://dataengineeringformachinelearning.com/documentation",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "https://dataengineeringformachinelearning.com/blog/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "https://dataengineeringformachinelearning.com/blog/",
      "permanent": true
    },
    {
      "source": "/blog/rss.xml",
      "destination": "https://dataengineeringformachinelearning.com/blog/rss.xml",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "https://dataengineeringformachinelearning.com/blog/:slug/",
      "permanent": true
    },
    {
      "source": "/learn",
      "destination": "https://dataengineeringformachinelearning.com/blog/",
      "permanent": true
    },
    {
      "source": "/learn/",
      "destination": "https://dataengineeringformachinelearning.com/blog/",
      "permanent": true
    },
    {
      "source": "/learn/:slug",
      "destination": "https://dataengineeringformachinelearning.com/blog/:slug/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assets/widget.js",
      "destination": "https://backend.deml.app/static/widgets/widget.js"
    },
    {
      "source": "/assets/widget.css",
      "destination": "https://backend.deml.app/static/widgets/widget.css"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
