{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node set-env.js && npm run build:contracts && NG_BUILD_MAX_WORKERS=1 GOMAXPROCS=1 NODE_OPTIONS=--max-old-space-size=1536 npx ng build --configuration vercel",
  "outputDirectory": "dist/deml/browser",
  "framework": null,
  "installCommand": "rm -rf node_modules/deml-ui && npm install --include=dev --prefer-online --no-audit --no-fund",
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://backend.deml.app/api/v1/docs",
      "permanent": false
    },
    {
      "source": "/docs/",
      "destination": "https://backend.deml.app/api/v1/docs",
      "permanent": false
    },
    {
      "source": "/redoc",
      "destination": "https://backend.deml.app/api/v1/redoc",
      "permanent": false
    },
    {
      "source": "/redoc/",
      "destination": "https://backend.deml.app/api/v1/redoc",
      "permanent": false
    },
    {
      "source": "/swagger",
      "destination": "https://backend.deml.app/api/v1/docs",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/assets/widget.js",
      "destination": "https://backend.deml.app/static/widgets/widget.js"
    },
    {
      "source": "/assets/widget.css",
      "destination": "https://backend.deml.app/static/widgets/widget.css"
    },
    {
      "source": "/((?!.*\\.(?:js|mjs|css|map|png|jpe?g|gif|ico|svg|webp|woff2?|json|webmanifest|txt|xml)$).*)",
      "destination": "/index.html"
    }
  ]
}
